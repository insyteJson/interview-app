# Copy to .streamlit/secrets.toml locally, or paste into the hosting provider's secrets field.
ANTHROPIC_API_KEY = "sk-ant-..."
MODEL = "claude-opus-5-5"
# Opus 5.5 does not allow setting temperature. Thinking depth is set with EFFORT: low, medium, high, xhigh or max.
EFFORT = "medium"
# Leave DATABASE_URL commented out for local testing (the app then uses a local SQLite file, interviews.db).
# For the hosted app, remove the leading "# " and fill in your real Supabase session-pooler string:
# DATABASE_URL = "postgresql+psycopg2://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
ADMIN_PASSWORD = "choose-a-long-password"
# Only these codes can start a session. Leave empty to allow any code (not recommended).
ALLOWED_CODES = "P01,P02,P03,P04,P05,P06,P07,P08,TEST1"
# 0 = no cap on the number of positions. Decide before data collection (Appendix C §9).
MAX_POSITIONS = "0"
# Public address of the app, used to build invite and personal links for recruiters (e.g. "https://your-app.streamlit.app/").
APP_URL = ""
# Optional: email to you when a session is starred automatically. Gmail needs an app password
# (Google account > Security > 2-Step Verification > App passwords). Other providers: set SMTP_HOST/PORT/USER too.
# NOTIFY_EMAIL_TO = "you@gmail.com"
# SMTP_PASSWORD = "abcd efgh ijkl mnop"
